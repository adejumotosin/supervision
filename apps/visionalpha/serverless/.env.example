SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-side-secret

# Keep disabled until the Cloud Run GPU job and trigger credentials are configured.
ENABLE_SEMANTIC_UPLOADS=0
MAX_SEMANTIC_UPLOAD_BYTES=1073741824

# Cloud Run Jobs trigger. Use a minimally scoped service account that can run only the worker job.
GCP_PROJECT_ID=your-google-cloud-project
GCP_REGION=europe-west1
GCP_WORKER_JOB=visionalpha-semantic-worker
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account"}
